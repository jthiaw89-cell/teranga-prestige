      "description": "Kanban tasks and checklists."
    },
    "/workspaces/{workspaceId}/planning_events/{eventId}": {
      "schema": { "$ref": "#/entities/PlanningEvent" },
      "description": "Unified calendar and planning entries."
    },
    "/workspaces/{workspaceId}/ged_documents/{gedId}": {
      "schema": { "$ref": "#/entities/GedDocumentMeta" },
      "description": "GED document vault metadata (files kept under 1MB limit)."
    },
    "/workspaces/{workspaceId}/accounting_entries/{entryId}": {
      "schema": { "$ref": "#/entities/AccountingEntryMeta" },
      "description": "SYSCOHADA journal entry metadata."
