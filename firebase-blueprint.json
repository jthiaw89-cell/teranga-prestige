  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Public user profile metadata keyed by Firebase Auth UID."
    },
    "/users/{userId}/private/{docId}": {
      "schema": { "$ref": "#/entities/UserPrivateInfo" },
      "description": "Private PII subcollection isolated per user."
    },
    "/admins/{userId}": {
      "schema": { "$ref": "#/entities/AdminRegistry" },
      "description": "Trusted platform admin UID registry."
    },
    "/workspaces/{workspaceId}": {
      "schema": { "$ref": "#/entities/Workspace" },
      "description": "Organization workspace root documents."
    },
    "/workspaces/{workspaceId}/members/{memberId}": {
      "schema": { "$ref": "#/entities/WorkspaceMember" },
      "description": "Workspace membership subcollection for Master Gate authorization."
    },
    "/workspaces/{workspaceId}/crm_contacts/{contactId}": {
      "schema": { "$ref": "#/entities/CrmContact" },
      "description": "CRM contacts and prospects for the workspace."
    },
    "/workspaces/{workspaceId}/crm_documents/{docId}": {
      "schema": { "$ref": "#/entities/CrmDocument" },
      "description": "Commercial quotes, orders, delivery slips, and invoices."
    },
    "/workspaces/{workspaceId}/campaigns/{campaignId}": {
      "schema": { "$ref": "#/entities/MarketingCampaign" },
      "description": "Multi-channel marketing & retargeting campaigns."
    },
    "/workspaces/{workspaceId}/missions/{missionId}": {
