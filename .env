# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
DATABASE_URL=postgresql://accounting_user:change-me@localhost:5432/teranga_accounting
DATABASE_SSL=false
DATABASE_POOL_SIZE=10
ACCOUNTING_API_PORT=3001
APP_ORIGIN=http://localhost:3000
TRUST_PROXY=false

# À définir uniquement pour `npm run accounting:bootstrap`.
ACCOUNTING_ORGANIZATION_ID=tenant-senelec
ACCOUNTING_ORGANIZATION_NAME=Senelec Digital
ACCOUNTING_ADMIN_EMAIL=comptabilite@example.sn
ACCOUNTING_ADMIN_NAME=Admin_compta
ACCOUNTING_ADMIN_PASSWORD=

# À définir uniquement pour `npm run intranet:bootstrap`.
INTRANET_ORGANIZATION_ID=tenant-senelec
INTRANET_ORGANIZATION_NAME=Senelec Digital
INTRANET_ADMIN_EMAIL=admin-intranet@example.sn
INTRANET_ADMIN_NAME=Admin
INTRANET_ADMIN_PASSWORD=Claudinho8189!
